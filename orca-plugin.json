{
  "manifestVersion": 2,
  "id": "workflow-view",
  "name": "Workflow View",
  "version": "0.1.0",
  "description": "Per-project workflow templates (plan → review → dev → review → tests → commit) with one-click portability, an orchestration Runs panel, and gate management.",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "workflow",
        "title": "Workflow",
        "icon": "activity",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "customEditors": [
      {
        "id": "workflow-graph",
        "title": "Workflow Graph",
        "entry": "src/editor/entry.ts",
        "extensions": [
          ".workflow.yaml",
          ".yaml"
        ],
        "frame": "isolated"
      }
    ],
    "newFiles": [
      {
        "id": "new-workflow",
        "title": "Новый воркфлоу",
        "extension": ".workflow.yaml",
        "template": "assets/new-workflow.workflow.yaml"
      }
    ],
    "statusBarItems": [
      {
        "id": "wf-status",
        "text": "Workflow",
        "icon": "activity",
        "tooltip": "Workflow View"
      }
    ],
    "events": [
      {
        "on": "agent.status.changed"
      },
      {
        "on": "workspace.changed"
      }
    ],
    "settings": [
      {
        "key": "libraryDir",
        "title": "Library directory (portable workflow templates)",
        "type": "string",
        "default": "~/orca-plugins/workflow-view/workflows",
        "placeholder": "~/orca-plugins/workflow-view/workflows"
      },
      {
        "key": "refreshMs",
        "title": "Refresh interval, ms (2000–120000)",
        "type": "integer",
        "default": 10000,
        "minimum": 2000,
        "maximum": 120000
      },
      {
        "key": "defaultAgent",
        "title": "Default agent for task start",
        "type": "string",
        "default": "claude",
        "placeholder": "claude"
      },
      {
        "key": "autoPilot",
        "title": "Auto-pilot: start ready steps, drive review loops (gates still stop for you)",
        "type": "boolean",
        "default": true
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage:own"
    },
    {
      "kind": "settings:own"
    },
    {
      "kind": "terminal:send"
    },
    {
      "kind": "terminal:read"
    },
    {
      "kind": "workspace:read"
    },
    {
      "kind": "workspace:write"
    },
    {
      "kind": "agent:read"
    }
  ]
}